<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#0f172a">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Remote Support"
        android:textColor="#f1f5f9"
        android:textSize="28sp"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#94a3b8"
        android:textSize="16sp"
        android:paddingBottom="4dp" />

    <TextView
        android:id="@+id/sessionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#64748b"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:paddingBottom="24dp" />

    <Button
        android:id="@+id/scanButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Scan QR Code"
        android:textColor="#ffffff"
        android:backgroundTint="#2563eb"
        android:paddingVertical="12dp" />

    <Button
        android:id="@+id/allowButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Allow Screen Sharing"
        android:textColor="#ffffff"
        android:backgroundTint="#2563eb"
        android:paddingVertical="12dp"
        android:enabled="false" />

    <Button
        android:id="@+id/stopButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stop Screen Sharing"
        android:textColor="#ffffff"
        android:backgroundTint="#dc2626"
        android:paddingVertical="12dp"
        android:enabled="false" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Your screen is shared in real time only after you explicitly allow it. You can stop at any time."
        android:textColor="#64748b"
        android:textSize="13sp" />

</LinearLayout>