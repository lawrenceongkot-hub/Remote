# =============================================================================
# Environment Configuration — no real secrets in this file.
# Copy to packages/web/.env.local and fill in real values for local dev.
# For production, set these in Vercel Project Settings → Environment Variables.
# =============================================================================

# ---- Database (required) ----
# PostgreSQL connection string. Required — no default fallback.
# Local example: postgres://remote_support:remote_support_dev@localhost:5433/remote_support
DATABASE_URL=postgres://CHANGE_ME

# ---- Admin login (required, server-side only) ----
# Used by /generateapi. Never expose to the browser.
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- Session signing secret (required) ----
SESSION_SECRET=CHANGE_ME_RANDOM_SECRET

# ---- Public app URL ----
NEXT_PUBLIC_APP_URL=https://YOUR-DOMAIN.com

# ---- WebSocket signaling ----
# Local dev: ws://localhost:3001/ws
# Production: wss://YOUR-DOMAIN/ws if the signaling server shares the domain,
# or ws(s)://YOUR-SIGNALING-HOST/ws
NEXT_PUBLIC_WS_URL=wss://YOUR-DOMAIN/ws
NEXT_PUBLIC_WS_HOST=localhost:3001

# ---- STUN (public, safe to commit defaults) ----
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# ---- TURN (optional, never commit production credentials) ----
# TURN_SERVERS=[{"urls":["turn:turn.example.com:3478"],"username":"user","credential":"pass"}]

# ---- Session TTL (ms) ----
SESSION_TTL_MS=300000

# ---- Allowed CORS origins for the signaling server ----
ALLOWED_ORIGINS=https://YOUR-DOMAIN.com